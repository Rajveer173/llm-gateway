PORT=3000
DATABASE_URL=postgresql://gateway:gateway@localhost:5433/gateway
REDIS_URL=redis://localhost:6380

# Providers — each is enabled when its setting is present
OLLAMA_URL=http://localhost:11434
# GEMINI_API_KEY=
# OPENAI_API_KEY=
MOCK_PROVIDER=true
MOCK_LATENCY_MS=50
# ROUTES_JSON=[{"modelPrefix":"fast","providers":["gemini","ollama"],"modelMap":{"gemini":"gemini-2.0-flash-lite","ollama":"qwen2.5:0.5b"}}]

CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_MS=30000
CACHE_TTL_SECONDS=3600
AUTH_CACHE_TTL_MS=10000
METER_FLUSH_MS=1000

# Guardrails
CANARIES=
BLOCK_INJECTION_PATTERNS=true

# Admin API is disabled unless this is set (min 24 chars)
ADMIN_TOKEN=change-me-to-a-long-random-string
# METRICS_TOKEN=

# Public demo page at /
DEMO_ENABLED=true
DEMO_MODELS=fast
DEMO_RATE_CAPACITY=8
DEMO_RATE_REFILL_PER_SEC=0.1
DEMO_MAX_TOKENS=300

LOG_LEVEL=info
# Set true behind a reverse proxy so per-IP limits see the real client IP
TRUST_PROXY=false
