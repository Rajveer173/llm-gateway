{
  "name": "llm-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "OpenAI-compatible LLM gateway: auth, Redis token-bucket rate limiting, caching, streaming, provider fallback, guardrails, metering",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/ratelimit/tokenBucket.lua','dist/ratelimit/tokenBucket.lua')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "key:create": "tsx scripts/createKey.ts",
    "devdb": "tsx scripts/devdb.ts",
    "test:integration": "INTEGRATION=1 vitest run test/integration",
    "load": "tsx load/run.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@prisma/client": "^6.19.3",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.4",
    "ioredis": "^5.11.1",
    "prisma": "^6.19.3",
    "prom-client": "^15.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22.20.2",
    "autocannon": "^8.0.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
